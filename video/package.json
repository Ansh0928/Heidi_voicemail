{
  "name": "heidi-voicemail-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render src/index.ts VideoWalkthrough --output ../public/walkthrough.mp4 --codec h264 --crf 18",
    "render:preview": "remotion render src/index.ts VideoWalkthrough --output ../public/walkthrough-preview.mp4 --codec h264 --crf 28 --scale 0.5"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/media-utils": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0"
  }
}
